<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 🔥 Gradient background -->
    <gradient
        android:startColor="#FF0000"
        android:endColor="#EF9F8D"
        android:angle="45"
        android:type="linear" />

    <!-- Smooth rounded corners -->
    <corners android:radius="18dp" />

    <!-- Soft border for glass-like highlight -->
    <stroke
        android:width="1dp"
        android:color="#70F40000" />

    <!-- Optional inner padding for visual balance -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>
