<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused / Active -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- Slightly stronger glass tone when focused -->
            <solid android:color="#33A8DFF0" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/primary_blue" /> <!-- accent border -->
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

    <!-- Default / Unfocused -->
    <item>
        <shape android:shape="rectangle">
            <!-- Frosted bluish-white background -->
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="16dp" />
            <!-- Soft translucent white border -->
            <stroke
                android:width="1.5dp"
                android:color="#80FFFFFF" />
            <padding
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp" />
        </shape>
    </item>

</selector>
