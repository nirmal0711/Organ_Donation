<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- ✨ Gradient Background -->
    <gradient
        android:startColor="#001C24"
        android:endColor="#2F80ED"
        android:angle="45"
        android:type="linear" />

    <!-- Rounded corners -->
    <corners android:radius="18dp" />

    <!-- Subtle border glow for glass effect -->
    <stroke
        android:width="1dp"
        android:color="#8000ABFF" />

    <!-- Soft shadow feel on modern devices -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>
