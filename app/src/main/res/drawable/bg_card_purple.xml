<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- ✨ Gradient background -->
    <gradient
        android:startColor="#9D50BB"
        android:endColor="#6200F8"
        android:angle="45"
        android:type="linear" />

    <!-- Rounded corners for card smoothness -->
    <corners android:radius="18dp" />

    <!-- Thin white border for glass-like edge -->
    <stroke
        android:width="1dp"
        android:color="#707D00F8" />

    <!-- Optional padding for inner glow -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>
