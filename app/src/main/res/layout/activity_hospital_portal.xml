<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_screen">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#33000000"
        app:title="Hospital Portal"
        app:titleTextColor="@android:color/white"
        android:elevation="4dp" />

    <!-- MAIN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospital Portal"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="40dp" />

            <!-- ADD DONATION -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddDonation"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="300dp"
                android:layout_height="80dp"
                android:text="Add New Donation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_add"
                app:iconTint="@android:color/white"
                app:iconGravity="start"
                app:cornerRadius="16dp"
                android:backgroundTint="#4CAF50"
                android:layout_marginBottom="20dp" />

            <!-- VIEW INVENTORY -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewInventory"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="300dp"
                android:layout_height="80dp"
                android:text="View Available Donations"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:iconTint="@android:color/white"
                app:iconGravity="start"
                app:cornerRadius="16dp"
                android:backgroundTint="#2196F3"
                android:layout_marginBottom="20dp" />

            <!-- PATIENT REQUESTS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPatientRequests"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="300dp"
                android:layout_height="80dp"
                android:text="Patient Organ Requests"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_requests"
                app:iconTint="@android:color/white"
                app:iconGravity="start"
                app:cornerRadius="16dp"
                android:backgroundTint="#FF9800"
                android:layout_marginBottom="20dp" />

            <!-- HOSPITAL PROFILE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHospitalProfile"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="300dp"
                android:layout_height="80dp"
                android:text="Edit Hospital Profile"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_edit"
                app:iconTint="@android:color/white"
                app:iconGravity="start"
                app:cornerRadius="16dp"
                android:backgroundTint="#9C27B0"
                android:layout_marginBottom="40dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>