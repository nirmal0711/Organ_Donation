<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient_screen"
    android:scrollbars="none"
    tools:context=".activities.PatientRequestActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- 🌈 HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_header_glass"
            android:padding="20dp"
            android:elevation="8dp"
            android:layout_marginBottom="20dp"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_requests"
                android:background="@drawable/bg_white_glass_circle"
                android:padding="12dp"
                android:elevation="4dp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organ Donation Request"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 💎 REQUEST FORM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="26dp"
            app:cardElevation="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/primary_blue"
            android:layout_marginBottom="40dp"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 🫀 Organ Type -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Organ Type (e.g., Heart, Kidney)"
                    app:startIconDrawable="@drawable/ic_organ"
                    app:boxStrokeColor="@color/primary_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOrganType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 💉 Blood Group -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Blood Group (e.g., O+, AB-)"
                    app:startIconDrawable="@drawable/ic_blood"
                    app:boxStrokeColor="@color/primary_blue"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBloodGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 📍 Location -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Your Location / City / Hospital"
                    app:startIconDrawable="@drawable/ic_location"
                    app:boxStrokeColor="@color/primary_blue"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ⚡ Urgency -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgency Level"
                    android:textColor="@color/primary_dark_blue"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerUrgency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_spinner"
                    android:popupBackground="@drawable/bg_popup_dark"
                    android:padding="12dp" />

                <!-- 🧾 Submit -->
                <Button
                    android:id="@+id/btnSubmitRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit Request"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@android:color/white"
                    android:background="@drawable/btn_glass_gradient"
                    android:elevation="6dp"
                    android:layout_marginTop="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
